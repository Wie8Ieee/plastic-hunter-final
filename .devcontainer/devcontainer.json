{
  "name": "Plastic Hunter AI",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Plastic Hunter AI",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    }
  },
  "postStartCommand": "nohup python -m uvicorn main:app --host 0.0.0.0 --port 8000 > /tmp/plastic-hunter.log 2>&1 &"
}
